# Copy to server/.env and fill in.

# MongoDB connection string (local or Atlas). Leave unset in development to
# run an in-memory MongoDB that is seeded automatically on start.
# MONGODB_URI=mongodb://127.0.0.1:27017/bim-portfolio

# Set to 0 to skip the in-memory database (its first start downloads ~600 MB).
# MEMORY_DB=0

PORT=5000

# Token for reading contact messages: GET /api/messages with
# header "Authorization: Bearer <ADMIN_TOKEN>". Unset = endpoint disabled.
# ADMIN_TOKEN=change-me
